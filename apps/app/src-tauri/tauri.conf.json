{
  "$schema": "https://schema.tauri.app/config/2.json",
  "productName": "Mirath",
  "version": "0.0.1",
  "identifier": "com.mirath.app",
  "build": {
    "beforeDevCommand": "pnpm dev --filter @mirath/app -- --port 1420",
    "beforeBuildCommand": "pnpm build --filter @mirath/app",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mirath",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
