{
  "name": "@mirath/mirath-format",
  "version": "0.0.1",
  "private": true,
  "description": ".mirath file format encoder/decoder (AES-256-GCM encrypted)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@mirath/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
